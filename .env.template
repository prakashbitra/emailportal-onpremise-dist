# ══════════════════════════════════════════════════════════════════
#  EmailPortal On-Premise — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never share your .env file with anyone.
# ══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
# Option A: Use the built-in database (set during setup wizard)
DATABASE_URL="postgresql://emailportal:CHANGE_ME@ep_db:5432/emailportal"

# Option B: Your own external PostgreSQL server
# DATABASE_URL="postgresql://USERNAME:PASSWORD@YOUR_DB_HOST:5432/emailportal?sslmode=require"

# ── Application ───────────────────────────────────────────────────
# Your server's URL (no trailing slash). Used for email links, cookies, OAuth.
# Caddy fronts the app on :80/:443 now — no :3000 in the URL, even without a
# real domain (PUBLIC_DOMAIN below can stay blank for IP-only/plain-HTTP access).
NEXTAUTH_URL="http://YOUR_SERVER_IP_OR_DOMAIN"

# Random secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="REPLACE_NEXTAUTH_SECRET"

# Encryption key for stored secrets (SES keys, SSO secrets, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: must be a DIFFERENT value from NEXTAUTH_SECRET and INSTANCE_SECRET
# below — these three are deliberately independent, so a leak of any one
# doesn't also compromise the other two.
ENCRYPTION_KEY="REPLACE_ENCRYPTION_KEY"

# ── License & Instance Identity ───────────────────────────────────
# Random secret that binds this license to your server.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Use the SAME value on every node in a cluster, but a DIFFERENT
# value from NEXTAUTH_SECRET/ENCRYPTION_KEY above.
# Send this value to support when requesting your license key.
INSTANCE_SECRET="REPLACE_INSTANCE_SECRET"

# Domain this server is reachable at, if any (used for Caddy's automatic
# HTTPS and for domain-bound licenses). Leave unset for IP-only/plain-HTTP
# access — Caddy falls back to plain HTTP on :80 in that case.
PUBLIC_DOMAIN=""

# Your license key (paste after receiving from support)
# Leave blank on first run — enter via the setup wizard.
LICENSE_KEY=""

# Where to check for updates (Admin > Infrastructure > "Check for Updates").
# Downloads are only offered while your maintenance contract (AMC) is active.
LICENSE_HUB_URL="https://license.brandmaster.ae"

# ── App version (set automatically by release script) ─────────────
APP_VERSION="1.1.10"
